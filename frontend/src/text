
.ai-copilot {
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
}

.ai-copilot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
  border-bottom: 1px solid var(--border);
  background: #fafbfc;
}

.ai-copilot-title {
  font-size: 15px;
  font-weight: 700;
}

.ai-copilot-subtitle {
  margin-top: 3px;
  color: var(--muted);
  font-size: 12px;
}

.ai-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--green);
}

.ai-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green);
}

.ai-chat {
  max-height: 360px;
  overflow-y: auto;
  padding: 16px;
}

.ai-message {
  max-width: 82%;
  margin-bottom: 12px;
}

.ai-message-user {
  margin-left: auto;
}

.ai-message-assistant {
  margin-right: auto;
}

.ai-message-label {
  margin-bottom: 4px;
  font-size: 11px;
  font-weight: 600;
  color: var(--muted);
}

.ai-message-content {
  padding: 10px 12px;
  border-radius: 8px;
  line-height: 1.5;
  white-space: pre-wrap;
}

.ai-message-user .ai-message-content {
  background: var(--blue-light);
}

.ai-message-assistant .ai-message-content {
  background: #f4f6f9;
  border: 1px solid #eef1f5;
}

.ai-thinking {
  color: var(--muted);
  font-style: italic;
}

.ai-suggestions {
  padding: 12px 16px;
  border-top: 1px solid var(--border);
  background: #fafbfc;
}

.ai-suggestions-title {
  margin-bottom: 8px;
  font-size: 11px;
  font-weight: 600;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.ai-suggestions button {
  margin: 0 7px 7px 0;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #ffffff;
  color: var(--text);
  font-size: 12px;
  cursor: pointer;
}

.ai-suggestions button:hover {
  background: var(--blue-light);
  border-color: var(--blue);
}

.ai-input-area {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  padding: 14px 16px;
  border-top: 1px solid var(--border);
}

.ai-input-area textarea {
  flex: 1;
  min-height: 70px;
  padding: 10px 12px;
  resize: vertical;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: #ffffff;
  color: var(--text);
  font-family: inherit;
  font-size: 13px;
}

.ai-input-area textarea:focus {
  outline: none;
  border-color: var(--blue);
  box-shadow: 0 0 0 2px var(--blue-light);
}

.ai-input-area .btn {
  min-width: 90px;
}

@media (max-width: 700px) {
  .ai-input-area {
    flex-direction: column;
    align-items: stretch;
  }

  .ai-input-area .btn {
    width: 100%;
  }

  .ai-message {
    max-width: 95%;
  }
}